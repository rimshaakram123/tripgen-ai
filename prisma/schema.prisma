generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
  runtime  = "nodejs"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String      @id @default(cuid())
  name      String?
  email     String      @unique
  password  String?
  image     String?
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  travelDNA TravelDNA?
  trips     Trip[]
}

model TravelDNA {
  id          String  @id @default(cuid())
  userId      String  @unique
  user        User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  adventure   Int     @default(0)
  culture     Int     @default(0)
  food        Int     @default(0)
  nature      Int     @default(0)
  photography Int     @default(0)
  relaxation  Int     @default(0)
  nightlife   Int     @default(0)
  budget      Int     @default(0)

  personality String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model Trip {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  destination String
  description String?
  startDate   DateTime
  endDate     DateTime
  budget      Float?
  currency    String   @default("USD")
  coverImage  String?

  status      TripStatus @default(DRAFT)

  itinerary   Json?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
  @@index([destination])
}

enum TripStatus {
  DRAFT
  PLANNED
  ACTIVE
  COMPLETED
  CANCELLED
}
